{
  "name": "@ripcats/voice-recorder",
  "version": "0.1.2",
  "description": "Запись голоса в браузере: Ogg/Opus через WebCodecs и AudioWorklet, пауза и продолжение, превью",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --import ./test/register.mjs --test \"test/**/*.test.mjs\"",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "mediabunny": "^1.65.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  }
}
